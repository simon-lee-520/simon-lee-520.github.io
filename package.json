{
  "name": "hexo-blog-simon7520",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=9.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "9.0.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "chokidar": "^3.6.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "chokidar"
      ],
      "allowAny": [
        "chokidar"
      ]
    }
  },
  "scripts": {
    "start": "pnpm run server",
    "server": "pnpm run models && hexo server",
    "models": "pnpm run models:swordsman && pnpm run models:jellyfish",
    "models:swordsman": "node tools/fetch-swordsman-vrm.mjs",
    "models:jellyfish": "node tools/fetch-jellyfish-glb.mjs",
    "build": "pnpm run models && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo generate && hexo deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scroll-director": "vitest run test/scroll-director.test.mjs",
    "test:animator": "vitest run test/animator.test.mjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-abbrlink": "^2.2.1",
    "hexo-butterfly-tag-plugins-plus": "^1.0.18",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.4.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-kramed": "^0.1.4",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "^3.0.4",
    "hexo-theme-landscape": "^0.0.3",
    "hexo-word-counter": "0.2.2",
    "prism-themes": "^1.8.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "3.3.6",
    "canvas": "^3.2.3",
    "sharp": "^0.34.5",
    "vitest": "^3.2.4"
  }
}